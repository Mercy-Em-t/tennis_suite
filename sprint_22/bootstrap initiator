### Step 2: Provision the Grammar-Based Code Generation Script

Create a bootstrap utility script named `.engine/generate.js`. This script acts as the recursive parser. It reads your seed configuration data and outputs modular functional architecture directly on the fly.

Save the following file as `.engine/generate.js`:

```javascript
const fs = require('fs');
const path = require('path');

// 1. Recursive parsing engine for minimal seed configuration strings
function parseSeedAndExecute(seedNode, baseDir) {
    console.log(`[SEED_PARSER]: Processing node -> ${seedNode.name || seedNode.seedTarget}`);
    
    // Determine the active generation directory target path
    const targetPath = seedNode.generationOutputDirectory 
        ? path.resolve(seedNode.generationOutputDirectory)
        : baseDir;

    if (!fs.existsSync(targetPath)) {
        fs.mkdirSync(targetPath, { recursive: true });
    }

    // Process and evaluate code arrays dynamically if they exist
    if (seedNode.modulesToEmit && Array.isArray(seedNode.modulesToEmit)) {
        seedNode.modulesToEmit.forEach(module => {
            const moduleFileName = `${module.name}.ts`;
            const fullFilePath = path.join(targetPath, moduleFileName);
            
            // Generate standard boilerplate based on the type metadata vector
            const structuralTemplate = generateTemplate(module);
            
            fs.writeFileSync(fullFilePath, structuralTemplate, 'utf8');
            console.log(`   ├── [EMITTED COMPONENT]: ${fullFilePath}`);
        });
    }
}

// 2. Structural templates generation map
function generateTemplate(module) {
    return `/**
 * Automatically Generated by TennisSuite Grammar Engine
 * Module: ${module.name}
 * Type: ${module.type}
 * Built on: ${new Date().toISOString()}
 */

export const ${module.name}Config = ${JSON.stringify(module.properties, null, 2)};

export function initialize${module.name}() {
    console.log("[${module.name}]: Operational state activated.");
}`;
}

// Load and read seed configuration file on demand
try {
    const seedConfigPath = path.join(__dirname, 'seed.json');
    if (fs.existsSync(seedConfigPath)) {
        const rawSeedData = fs.readFileSync(seedConfigPath, 'utf8');
        const seedJson = JSON.parse(rawSeedData);
        parseSeedAndExecute(seedJson, path.join(__dirname, 'generated'));
        console.log("\n[SYSTEM TERMINAL]: Grammar seed parsing loops executed successfully.");
    } else {
        console.error("[CRITICAL]: seed.json configuration missing inside .engine/ directory.");
    }
} catch (error) {
    console.error("[CRITICAL COMPILATION FAULT]:", error);
}

```

